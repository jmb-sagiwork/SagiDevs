    def resolve_tax_id_and_provider_name(self, claim_data):
        """Handle OneView sections where TIN and provider name can be read reversed."""
        tin_value = claim_data.get("TIN", "")
        provider_value = claim_data.get("Servicing Provider", "")

        if (
            not self.is_not_found_or_blank(tin_value)
            and not self.is_not_found_or_blank(provider_value)
            and not self.looks_like_tax_id(tin_value)
            and self.looks_like_tax_id(provider_value)
        ):
            return provider_value, tin_value

        return tin_value, provider_value

