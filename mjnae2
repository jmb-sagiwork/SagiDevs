    def validate_additional_info_entry(self, entry):
        try:
            value = entry.get().strip()
            entry.config(bg=self.colors["input_complete"] if value else self.colors["input_pending"])
        except Exception:
            pass

    def handle_additional_info_change(self, entry):
        self.validate_additional_info_entry(entry)
        self.sync_completed_additional_info_to_final_output()

    def is_additional_info_complete(self):
        if not self.additional_info_visible:
            return False

        if not self.additional_info_entries:
            return False

        for field_name in ADDITIONAL_INFO_FIELDS:
            entry = self.additional_info_entries.get(field_name)
            if entry is None:
                return False

            try:
                if not entry.get().strip():
                    return False
            except Exception:
                return False

        return True

    def get_completed_additional_info_block(self):
        if not self.is_additional_info_complete():
            return ""

        lines = ["Knowledge Article 56494 - Next Best Action:"]

        for field_name in ADDITIONAL_INFO_FIELDS:
            entry = self.additional_info_entries.get(field_name)
            value = entry.get().strip() if entry is not None else ""
            lines.append(f"{field_name}: {value}")

        return "\n".join(lines).strip()

    def remove_previous_additional_info_block(self, text):
        output = str(text or "")

        previous_block = str(self.last_additional_info_output_block or "").strip()
        if previous_block and previous_block in output:
            output = output.replace("\n\n" + previous_block, "")
            output = output.replace(previous_block, "")

        return output.rstrip()

    def add_completed_additional_info_to_text(self, text):
        base_text = self.remove_previous_additional_info_block(text)
        completed_block = self.get_completed_additional_info_block()

        if not completed_block:
            return base_text

        if "Additional notes:" in base_text:
            if base_text.rstrip().endswith("Additional notes:"):
                return base_text.rstrip() + "\n" + completed_block
            return base_text.rstrip() + "\n\n" + completed_block

        return base_text.rstrip() + "\n\n" + completed_block

    def sync_completed_additional_info_to_final_output(self):
        if not hasattr(self, "final_output_box"):
            return

        try:
            current_text = self.final_output_box.get("1.0", "end-1c")
        except Exception:
            return

        updated_text = self.add_completed_additional_info_to_text(current_text)
        completed_block = self.get_completed_additional_info_block()

        if updated_text != current_text:
            try:
                self.final_output_box.delete("1.0", tk.END)
                self.final_output_box.insert(tk.END, updated_text)
            except Exception:
                return

        self.last_additional_info_output_block = completed_block

