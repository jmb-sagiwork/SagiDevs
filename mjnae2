    def set_caller_field_if_blank_in_lines(self, lines, label, value):
        if self.is_not_found_or_blank(value):
            return lines

        pattern = re.compile(rf"^\s*{re.escape(label)}\s*:\s*(.*)$", flags=re.IGNORECASE)

        for index, line in enumerate(lines):
            match = pattern.match(line)
            if not match:
                continue

            current_value = match.group(1).strip()
            if not current_value:
                lines[index] = f"{label}: {str(value).strip()}"
            return lines

        lines.append(f"{label}: {str(value).strip()}")
        return lines

    def looks_like_tax_id(self, value):
        digits = re.sub(r"\D", "", str(value or ""))
