    def format_captured_note_item(self, text):
        cleaned = self.clean_selected_text(text)
        if not cleaned:
            return ""

        lines = cleaned.splitlines()
        if len(lines) == 1:
            return f"- {lines[0]}"

        first = f"- {lines[0]}"
        rest = [f"  {line}" for line in lines[1:]]
        return "\n".join([first] + rest)

    def append_capture_note_item(self, selected_text):
        cleaned = self.clean_selected_text(selected_text)
        if not cleaned:
            return

        key = re.sub(r"\s+", " ", cleaned).strip().lower()
        if not key or key in self.capture_notes_seen:
            return

        self.capture_notes_seen.add(key)
        self.capture_notes_items.append(cleaned)
        formatted = self.format_captured_note_item(cleaned)
        if not formatted:
            return

        def update():
            try:
                # Safety: if capture mode is active, the preview panel must be visible.
                if not self.capture_notes_visible:
                    if hasattr(self, "callers_info_outer"):
                        self.capture_notes_outer.pack(fill=tk.X, pady=(0, 8), before=self.callers_info_outer)
                    else:
                        self.capture_notes_outer.pack(fill=tk.X, pady=(0, 8))
                    self.capture_notes_visible = True

                current = self.capture_notes_box.get("1.0", "end-1c").strip()
                if current:
                    self.capture_notes_box.insert(tk.END, "\n" + formatted)
                else:
                    self.capture_notes_box.insert(tk.END, formatted)
                self.capture_notes_box.see(tk.END)

                count = len(self.capture_notes_seen)
                self.capture_notes_status_label.config(
                    text=f"Capture mode is ON. Captured {count} item(s). Press F8 again to add these notes to Additional notes."
                )
                self.root.update_idletasks()
                self.canvas.configure(scrollregion=self.canvas.bbox("all"))
            except Exception as e:
                self.append_log(f"Captured notes UI update warning: {type(e).__name__}: {e}")

        self.root.after(0, update)

        preview = cleaned.replace("\n", " ")
        if len(preview) > 80:
            preview = preview[:80] + "..."
        self.append_log(f"Captured highlighted note ({len(cleaned)} chars): {preview}")

    def monitor_capture_notes_highlight(self):
        if not self.capture_notes_active:
            return

        try:
            selected_text = self.driver.execute_script(
                "return window.getSelection ? window.getSelection().toString() : '';"
            )
        except WebDriverException:
            return

        selected_text = self.clean_selected_text(selected_text)

        if not selected_text:
            self.capture_candidate_text = ""
            self.capture_candidate_time = 0.0
            return

        normalized = re.sub(r"\s+", " ", selected_text).strip().lower()
        if normalized in self.capture_notes_seen:
            return

        now = time.time()

        if selected_text != self.capture_candidate_text:
            self.capture_candidate_text = selected_text
            self.capture_candidate_time = now
            return

        if now - self.capture_candidate_time < HIGHLIGHT_COPY_DEBOUNCE_SECONDS:
            return

        self.append_capture_note_item(selected_text)
        self.last_captured_highlight = selected_text

    def append_text_under_additional_notes(self, base_text, notes_text):
        base_text = str(base_text or "").rstrip()
        notes_text = str(notes_text or "").strip()

        if not notes_text:
            return base_text

        marker = "Additional notes:"

        if marker not in base_text:
            if base_text:
                return base_text + "\n\n" + marker + "\n" + notes_text
            return marker + "\n" + notes_text

        before, after = base_text.split(marker, 1)
        after = after.strip()

        if after:
            new_after = after + "\n" + notes_text
        else:
            new_after = notes_text

        return before.rstrip() + "\n" + marker + "\n" + new_after

    def commit_capture_notes_to_final_output(self, hide_after=True):
        notes_text = self.get_capture_notes_text_from_ui()
        if not notes_text:
            if hide_after:
                self.clear_capture_notes_state(hide=True)
            return False

        try:
            current_final = self.final_output_box.get("1.0", "end-1c")
            updated_final = self.append_text_under_additional_notes(current_final, notes_text)
            self.final_output_box.delete("1.0", tk.END)
            self.final_output_box.insert(tk.END, updated_final)
            self.last_final_output_text = updated_final
        except Exception as e:
            self.append_log(f"Captured notes commit warning: {type(e).__name__}: {e}")
            return False

        if hide_after:
            self.clear_capture_notes_state(hide=True)
        else:
            self.capture_notes_active = False

        self.append_log("Captured notes added under Additional notes.")
        return True

