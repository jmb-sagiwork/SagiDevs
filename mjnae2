        selected_text = self.clean_selected_text(selected_text)

        if not selected_text:
            self.highlight_candidate_text = ""
            self.highlight_candidate_time = 0.0
            return

        if selected_text == self.last_auto_copied_highlight:
            return

        now = time.time()

        if selected_text != self.highlight_candidate_text:
            self.highlight_candidate_text = selected_text
            self.highlight_candidate_time = now
            return

        if now - self.highlight_candidate_time < HIGHLIGHT_COPY_DEBOUNCE_SECONDS:
            return

        pyperclip.copy(selected_text)
        self.last_auto_copied_highlight = selected_text
        self.last_clipboard_text = selected_text

        preview = selected_text.replace("\n", " ")
        if len(preview) > 80:
            preview = preview[:80] + "..."

        self.append_log(f"Auto-copied highlighted text ({len(selected_text)} chars): {preview}")
        self.set_status("Highlighted OneView text copied. Use F2 to restore final output.", "warning")

