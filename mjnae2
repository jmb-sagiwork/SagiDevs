    # =========================

    def create_edge_driver(self):
        from selenium.webdriver.edge.service import Service
        import os

        options = webdriver.EdgeOptions()
        options.add_argument("--start-maximized")
        options.add_experimental_option("detach", True)

        if EDGE_DRIVER_PATH:
            self.append_log(f"Using EdgeDriver path: {EDGE_DRIVER_PATH}")

            if not os.path.exists(EDGE_DRIVER_PATH):
                raise FileNotFoundError(f"EdgeDriver not found: {EDGE_DRIVER_PATH}")

            service = Service(executable_path=EDGE_DRIVER_PATH)
            return webdriver.Edge(service=service, options=options)

        self.append_log("Using Selenium Manager for EdgeDriver.")
        return webdriver.Edge(options=options)

    def selenium_worker(self):
        try:
            self.driver = self.create_edge_driver()
            self.driver.get(TARGET_URL)

            self.target_window_handle = self.driver.current_window_handle

            self.append_log("Edge opened.")
            self.append_log("Original OneView tab saved as target tab.")
            self.append_log("User may log in and work manually.")
            self.append_log("Watching only the original OneView tab.")
            self.append_log("New tabs will be ignored.")
            self.append_log("Auto Copy Highlight is OFF by default.")
            self.set_status("OneView is open. Select Claims or Eligibility to enable scanning.", "success")

            while not self.stop_event.is_set():
                try:
                    self.monitor_target_tab()
                except Exception as e:
                    self.append_log(f"Monitor loop warning: {type(e).__name__}: {e}")

                time.sleep(POLL_SECONDS)

        except Exception:
            self.append_log("Fatal error:")
            self.append_log(traceback.format_exc())
            self.set_status("Fatal error. Check terminal logs.", "danger")

        finally:
            self.running = False
            self.root.after(0, lambda: self.start_btn.config(state=tk.NORMAL))
            self.root.after(0, lambda: self.stop_btn.config(state=tk.DISABLED))

    # =========================
    # FOCUS DETECTION
    # =========================

    def get_foreground_window_title(self):
        try:
            hwnd = ctypes.windll.user32.GetForegroundWindow()

            length = ctypes.windll.user32.GetWindowTextLengthW(hwnd)
            buffer = ctypes.create_unicode_buffer(length + 1)

            ctypes.windll.user32.GetWindowTextW(hwnd, buffer, length + 1)

            return buffer.value.strip()

        except Exception:
            return ""

    def is_oneview_foreground(self):
        if not PAUSE_WHEN_ONEVIEW_NOT_ACTIVE:
            return True

        title = self.get_foreground_window_title().lower()

        if not title:
            return False

        browser_match = any(
            keyword.lower() in title
            for keyword in FOREGROUND_BROWSER_KEYWORDS
        )

        page_match = any(
            keyword.lower() in title
            for keyword in FOREGROUND_TITLE_KEYWORDS
        )

        return browser_match and page_match

    # =========================
    # MONITORING - SINGLE TARGET TAB MODE
    # =========================

    def monitor_target_tab(self):
        if not self.driver:
            return

        if not self.target_window_handle:
            return

        if not self.is_oneview_foreground():
            return

        try:
            handles = self.driver.window_handles
        except WebDriverException:
            return

        if self.target_window_handle not in handles:
            self.append_log("Target OneView tab was closed. Stop and run again if needed.")
            self.stop_event.set()
            return

        try:
            current_handle = self.driver.current_window_handle
        except WebDriverException:
            return

        if current_handle != self.target_window_handle:
            # Do not force-switch tabs. Pause silently so the browser never jumps focus.
            return

        if not self.is_target_tab():
            return

        self.monitor_auto_copy_highlight()
        self.monitor_capture_notes_highlight()

        if not self.provider_concern:
            return

        if self.provider_concern == "Claims":
            self.monitor_claim_workflow()
            return

        if self.provider_concern == "Eligibility":
            self.monitor_eligibility_workflow()
            return

    def monitor_claim_workflow(self):
        trigger_text = self.get_text_if_exists(
            xpath=XPATH_TRIGGER_CLAIM_HEADER,
            mode="full_text",
            field_name="Claim Header",
        )

        if not trigger_text:
            return

        if trigger_text.strip().lower() == "details":
            self.append_log("Header is still DETAILS. Waiting for real claim number.")

        claim_number = self.wait_for_valid_claim_number()

        if not claim_number:
            self.append_log("Claim header detected, but claim number is not ready yet. Skipping this loop.")
            return

        current_claim_key = claim_number.strip()
        is_first_run = self.last_claim_number == ""

        if not is_first_run and current_claim_key == self.last_claim_number:
            return

        previous_claim = self.last_claim_number
        self.last_claim_number = current_claim_key

        if is_first_run:
            self.append_log(f"First claim detected: {current_claim_key}")

            confirm_message = (
                f"Detected claim:\n\n"
                f"{trigger_text}\n\n"
                f"Claim Number: {claim_number}\n\n"
                f"Is this the correct claim?"
            )
        else:
            self.append_log(f"New claim detected: {current_claim_key}")

            confirm_message = (
                f"A different claim was detected.\n\n"
                f"Previous Claim:\n{previous_claim}\n\n"
                f"Current Claim:\n{current_claim_key}\n\n"
                f"Header:\n{trigger_text}\n\n"
                f"Do you want to extract this claim?"
            )

        confirmed = system_modal_yes_no("Confirm Claim", confirm_message)

        if confirmed:
            self.append_log("User confirmed claim. Extracting...")
            self.set_status(f"Extracting claim {current_claim_key}...", "success")
            self.process_confirmed_claim()
        else:
            self.append_log("User selected No. Continuing watcher...")
            self.set_status("Claim skipped. Continuing watcher.", "info")



    def monitor_eligibility_workflow(self):
        detector_text = self.get_text_if_exists(
            xpath=XPATH_ELIGIBILITY_DETECTOR,
            mode="full_text",
            field_name="Eligibility Member",
        )

        if not detector_text:
            return

        current_member_key = detector_text.strip()

        # Confirm only when the detected member is new or changed.
        # If OneView moves from the subscriber to a dependent or another member,
        # the popup appears again because the detector text changed.
        if current_member_key == self.last_eligibility_member:
            return

        previous_member_key = self.last_eligibility_member
        self.last_eligibility_member = current_member_key

        if previous_member_key:
            self.append_log(f"Eligibility member changed: {previous_member_key} -> {current_member_key}")
        else:
            self.append_log(f"Eligibility member detected: {current_member_key}")

        confirmed = system_modal_yes_no(
            "Confirm Member",
            f"Detected member:\n\n{current_member_key}\n\nIs this the correct member?",
        )

        if confirmed:
            self.append_log("User confirmed eligibility member. Opening Eligibility detail view...")
            self.set_status("Opening Eligibility detail view...", "success")
            self.process_confirmed_eligibility(current_member_key)
        else:
            self.append_log("User selected No for eligibility member. Continuing watcher...")
            self.set_status("Eligibility member skipped. Continuing watcher.", "info")

    def process_confirmed_eligibility(self, member_text):
        self.autofill_callers_information_from_eligibility(member_text)
        opened = self.open_eligibility_details_view()

        if not opened:
            self.append_log("Eligibility warning: detail button was not clicked or detail view did not load.")
            self.set_status("Eligibility detail view was not opened. Check OneView screen.", "warning")

        eligibility_data = self.scrape_eligibility_data()
        self.current_eligibility_data = eligibility_data

        self.close_eligibility_details_view()

        self.handle_eligibility_data(member_text, eligibility_data)

    def click_xpath_if_exists(self, xpath, description="element", wait_seconds=0.0):
        end_time = time.time() + max(0.0, wait_seconds)

        while True:
            try:
                elements = self.driver.find_elements(By.XPATH, xpath)
                if elements:
                    element = elements[0]
                    try:
                        self.driver.execute_script("arguments[0].scrollIntoView({block: 'center'});", element)
                        time.sleep(0.1)
                        self.driver.execute_script("arguments[0].click();", element)
                    except WebDriverException:
                        element.click()

                    self.append_log(f"Clicked {description}.")
                    return True
            except (StaleElementReferenceException, NoSuchElementException, WebDriverException):
                pass

            if time.time() >= end_time:
                break

            time.sleep(0.25)

        return False

    def open_eligibility_details_view(self):
        clicked = self.click_xpath_if_exists(
            XPATH_ELIGIBILITY_DETAILS_BUTTON,
            description="Eligibility button",
            wait_seconds=6,
        )

        if not clicked:
            return False

        return self.wait_for_any_eligibility_detail_field(timeout_seconds=10)

    def wait_for_any_eligibility_detail_field(self, timeout_seconds=10):
        end_time = time.time() + timeout_seconds

        while time.time() < end_time:
            for field in ELIGIBILITY_FIELDS:
                value = self.get_text_if_exists(
                    xpath=field["xpath"],
                    mode=field.get("mode", "full_text"),
                    field_name=field["name"],
                )
                if value and str(value).strip().lower() != "not found":
                    return True

            time.sleep(0.35)

        return False

    def close_eligibility_details_view(self):
        closed = self.click_xpath_if_exists(
            XPATH_ELIGIBILITY_DETAILS_CLOSE,
            description="Eligibility close button",
            wait_seconds=3,
        )

        if closed:
            time.sleep(0.4)
        else:
            self.append_log("Eligibility close button was not found. Continuing without error.")

    def scrape_eligibility_data(self):
        data = {}

        for field in ELIGIBILITY_FIELDS:
            field_name = field["name"]
            xpath = field["xpath"]
            mode = field["mode"]

            value = self.get_text_if_exists(
                xpath=xpath,
                mode=mode,
                field_name=field_name,
            )

            if value and str(value).strip().lower() != "not found":
                data[field_name] = value.strip()
            else:
                data[field_name] = "Not found"

        return data

    def get_available_eligibility_items(self, eligibility_data):
        items = []

        for field in ELIGIBILITY_FIELDS:
            label = field["name"]
            value = str(eligibility_data.get(label, "") or "").strip()

            if not value or value.lower() == "not found":
                continue

            items.append({"label": label, "value": value})

        return items

    def format_eligibility_raw_data(self, member_text, eligibility_data):
        lines = []
        lines.append("Eligibility Information")
        lines.append("----------------------------------")
        lines.append(f"Detected Member: {member_text or 'Not found'}")
        lines.append(f"Provider Concern: {self.provider_concern or 'Not selected'}")
        lines.append("")

        for key, value in eligibility_data.items():
            lines.append(f"{key}: {value}")

        return "\n".join(lines)

    def build_eligibility_final_output(self, selected_items=None):
        selected_items = selected_items or []

        lines = [
            "Provider concern: Eligibility",
            "",
            "Information provided:",
        ]

        for item in selected_items:
            label = str(item.get("label", "")).strip()
            value = str(item.get("value", "")).strip()
            if label and value:
                lines.append(f"- {label}: {value}")

        lines.extend(["", "Additional notes:"])
        return "\n".join(lines)

    def handle_eligibility_data(self, member_text, eligibility_data):
        extracted_text = self.format_eligibility_raw_data(member_text, eligibility_data)
        base_final_output_text = self.build_eligibility_final_output([])

        self.last_extracted_text = extracted_text
        self.last_final_output_text = base_final_output_text

        self.set_text_box(self.extracted_data_box, extracted_text)
        self.set_text_box(self.final_output_box, base_final_output_text)

        self.append_log("===== ELIGIBILITY DATA CAPTURED =====")
        self.append_log(f"Detected Member: {member_text}")
        for key, value in eligibility_data.items():
            self.append_log(f"{key}: {value}")
        self.append_log("=====================================")

        available_items = self.get_available_eligibility_items(eligibility_data)
        self.current_eligibility_items = available_items
        self.selected_eligibility_items = []

        if not available_items:
            self.append_log("Eligibility fields were extracted, but no non-empty values were available for selection.")
            self.set_status("Eligibility data captured, but no values were available for selection.", "warning")
            return

        selected_items = self.ask_eligibility_info_selection_threadsafe(
            available_items,
            preselected_items=self.selected_eligibility_items,
        )
        self.apply_eligibility_selected_items(selected_items)

    def make_eligibility_item_key(self, item):
        return f"{item.get('label', '')}::{item.get('value', '')}"

    def apply_eligibility_selected_items(self, selected_items):
        self.selected_eligibility_items = selected_items or []
        final_output_text = self.build_eligibility_final_output(self.selected_eligibility_items)

        self.last_final_output_text = final_output_text
        combined_copy_text = self.build_combined_final_copy_text(final_text=final_output_text)
        self.last_clipboard_text = combined_copy_text

        self.set_text_box(self.final_output_box, final_output_text)
        pyperclip.copy(combined_copy_text)

        self.append_log("Callers Information + selected Eligibility output copied to clipboard.")
        self.set_status("Eligibility selections documented and copied.", "success")

    def reopen_eligibility_popup(self):
        if not self.current_eligibility_items:
            system_modal_info("No Eligibility Data", "No eligibility information has been retrieved yet.")
            self.set_status("No eligibility information has been retrieved yet.", "warning")
            return

        selected_items = self.ask_eligibility_info_selection_threadsafe(
            self.current_eligibility_items,
            preselected_items=self.selected_eligibility_items,
        )
        self.apply_eligibility_selected_items(selected_items)

    def ask_eligibility_info_selection_threadsafe(self, items, preselected_items=None):
        """Show the Eligibility selection popup.

        This method may be called from either the Selenium worker thread
        or the Tkinter UI thread. The previous version always used
        root.after(...) + queue.get(), which deadlocked when the user clicked
        Reopen Eligibility from the UI thread because the UI thread blocked
        before the popup could render.
        """
        result_queue = queue.Queue(maxsize=1)
        preselected_items = preselected_items or []
        result_holder = {"value": None, "set": False}

        def show_popup():
            popup = tk.Toplevel(self.root)
            popup.title("Eligibility")
            popup.configure(bg=self.colors["panel"])
            popup.attributes("-topmost", True)
            popup.resizable(False, False)
            popup.grab_set()

            selected_keys = {self.make_eligibility_item_key(item) for item in preselected_items}
            button_by_key = {}

            instruction = tk.Label(
                popup,
                text="What information did you provide?",
                bg="white",
                fg=self.colors["text"],
                font=("Segoe UI", 12, "bold"),
                anchor="center",
            )
            instruction.pack(fill=tk.X, padx=18, pady=(16, 10))

            info_frame = tk.Frame(popup, bg="white")
            info_frame.pack(fill=tk.BOTH, expand=True, padx=18, pady=(0, 12))

            def refresh_button(item):
                key = self.make_eligibility_item_key(item)
                btn = button_by_key.get(key)
                if not btn:
                    return

                if key in selected_keys:
                    btn.config(bg="#DDEFE7", fg=self.colors["text"], relief=tk.SOLID, bd=1)
                else:
                    btn.config(bg="#F8FAFC", fg=self.colors["text"], relief=tk.FLAT, bd=1)

            def toggle_item(item):
                key = self.make_eligibility_item_key(item)
                if key in selected_keys:
                    selected_keys.remove(key)
                else:
                    selected_keys.add(key)
                refresh_button(item)

            for index, item in enumerate(items):
                label = str(item.get("label", "")).strip()
                value = str(item.get("value", "")).strip()
                button_text = f"{label}\n{value}"

                btn = tk.Button(
                    info_frame,
                    text=button_text,
                    width=28,
                    height=3,
                    bg="#F8FAFC",
                    fg=self.colors["text"],
                    activebackground="#E0F2FE",
                    activeforeground=self.colors["text"],
                    justify=tk.CENTER,
                    wraplength=190,
                    relief=tk.FLAT,
                    bd=1,
                    font=("Segoe UI", 8, "bold"),
                    command=lambda item=item: toggle_item(item),
                )

                row = index // 2
                col = index % 2
                btn.grid(row=row, column=col, padx=5, pady=5, sticky="nsew")
                button_by_key[self.make_eligibility_item_key(item)] = btn
                refresh_button(item)

            for col in range(2):
                info_frame.columnconfigure(col, weight=1)

            action_frame = tk.Frame(popup, bg=self.colors["panel"])
            action_frame.pack(fill=tk.X, padx=18, pady=(0, 16))

            def finish_with(selected_items):
                result_holder["value"] = selected_items
                result_holder["set"] = True

                if result_queue.empty():
                    result_queue.put(selected_items)

                try:
                    popup.grab_release()
                except Exception:
                    pass

                popup.destroy()

            def done():
                selected_items = [
                    item
                    for item in items
                    if self.make_eligibility_item_key(item) in selected_keys
                ]
                finish_with(selected_items)

            done_btn = tk.Button(
                action_frame,
                text="Done",
                width=18,
                bg=self.colors["primary"],
                fg="white",
                activebackground=self.colors["primary_hover"],
                activeforeground="white",
                relief=tk.FLAT,
                padx=10,
                pady=8,
                font=("Segoe UI", 9, "bold"),
                command=done,
            )
            done_btn.pack(anchor="center")

            row_count = max(1, math.ceil(len(items) / 2))
            estimated_height = min(560, max(230, 105 + (row_count * 72)))
            popup.geometry(f"520x{estimated_height}")
            popup.update_idletasks()
            self.center_popup(popup)
            popup.lift()
            popup.focus_force()

            try:
                popup.attributes("-topmost", True)
                popup.after(500, lambda: popup.attributes("-topmost", True))
            except Exception:
                pass

            popup.protocol("WM_DELETE_WINDOW", done)
            return popup

        # If this is called from a UI button such as Reopen Eligibility,
        # do NOT block Tkinter with queue.get(). wait_window keeps Tk events alive.
        if threading.get_ident() == self.ui_thread_id:
            popup = show_popup()
            self.root.wait_window(popup)
            return result_holder["value"] if result_holder["set"] else []

        self.root.after(0, show_popup)
        return result_queue.get()

    def is_target_tab(self):
        try:
            url = self.driver.current_url or ""
            title = self.driver.title or ""

            if TARGET_DOMAIN.lower() in url.lower():
                return True

            if TARGET_TITLE_KEYWORD.lower() in title.lower():
                return True

            return False

        except WebDriverException:
            return False

    def safe_current_url(self):
        try:
            return self.driver.current_url
        except WebDriverException:
            return ""

    def is_valid_claim_number(self, value):
        if not value:
            return False

        text = str(value).strip()
        digits_only = re.sub(r"\D", "", text)

        return len(digits_only) >= 8

    def wait_for_valid_claim_number(self):
        end_time = time.time() + CLAIM_NUMBER_WAIT_SECONDS

        while time.time() < end_time:
            claim_number = self.get_text_if_exists(
                xpath=XPATH_CLAIM_NUMBER,
                mode="full_text",
                field_name="Claim Number",
            )

            if self.is_valid_claim_number(claim_number):
                return claim_number.strip()

            time.sleep(0.5)

        return ""

