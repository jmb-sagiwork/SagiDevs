    def process_confirmed_claim(self):
        self.current_claim_data = {}
        self.current_service_lines = []
        self.current_total_line = {}
        self.selected_service_line = None
        self.selected_service_lines = []
        self.selected_service_line_indices = set()
        self.selected_procedure_mode = None
        self.current_advisory_notes = []
        self.hide_additional_info_form(clear_values=True)
        self.update_another_code_button_state()

        claim_data = self.scrape_claim_data()
        self.current_claim_data = claim_data

        service_lines, total_line = self.scrape_service_line_table()
        self.current_service_lines = service_lines
        self.current_total_line = total_line

        self.append_log(f"Service lines detected: {len(self.current_service_lines)}")

        if self.current_total_line:
            self.append_log("Total row detected and stored separately.")
        else:
            self.append_log("Total row not found.")

        if self.current_service_lines:
            selection = self.ask_procedure_selection_threadsafe(
                self.current_service_lines,
                excluded_indices=set(),
                popup_subtitle="Select the code the caller is asking about.",
            )

            if selection is None:
                self.append_log("Procedure selection cancelled. No final output created.")
                self.set_status("Procedure selection cancelled. No final output created.", "warning")
                return

            self.apply_procedure_selection(selection, from_another_code=False)
        else:
            self.selected_procedure_mode = "ALL"
            self.selected_service_line = None
            self.selected_service_lines = []
            self.append_log("No service lines found. CPT popup skipped.")

            system_modal_info(
                "No CPT Rows Detected",
                "No CPT/service line rows were detected from the table.\n\n"
                "The claim/provider data will still be captured, but the procedure selection popup was skipped."
            )

        self.handle_scraped_data(claim_data)
        self.update_another_code_button_state()

    def apply_procedure_selection(self, selection, from_another_code=False):
        if selection == "ALL":
            remaining_indices = self.get_remaining_service_line_indices()

            if from_another_code and remaining_indices:
                for index in remaining_indices:
                    self.add_selected_service_line(index)
                self.selected_procedure_mode = "MULTI"
                self.append_log("User selected all remaining procedures.")
            else:
                self.selected_procedure_mode = "ALL"
                self.selected_service_line = None
                self.selected_service_lines = list(self.current_service_lines)
                self.selected_service_line_indices = set(range(len(self.current_service_lines)))
                self.append_log("User selected: All Procedures")

            self.show_advisory_for_selected_codes()
            self.maybe_show_additional_info_for_codes(self.get_selected_procedure_codes())
            return

        if isinstance(selection, int):
            self.add_selected_service_line(selection)
            selected_row = self.current_service_lines[selection]
            proc = self.get_display_proc_code(selected_row)
            self.append_log(f"User selected procedure: {proc}")
            self.show_advisory_for_codes([proc])
            self.maybe_show_additional_info_for_codes([proc])

    def add_selected_service_line(self, index):
        if index < 0 or index >= len(self.current_service_lines):
            return

        if index in self.selected_service_line_indices:
            return

        self.selected_service_line_indices.add(index)
        row = self.current_service_lines[index]
        self.selected_service_lines.append(row)

        if len(self.selected_service_lines) == 1:
            self.selected_procedure_mode = "SINGLE"
            self.selected_service_line = row
        else:
            self.selected_procedure_mode = "MULTI"
            self.selected_service_line = None

    def handle_another_code(self):
        if not self.current_service_lines:
            system_modal_info("No Claim Data", "No service line data is available yet.")
            return

        remaining_indices = self.get_remaining_service_line_indices()

        if not remaining_indices:
            system_modal_info("No More Codes", "All available CPT/procedure codes have already been selected.")
            self.update_another_code_button_state()
            return

        selection = self.ask_procedure_selection_threadsafe(
            self.current_service_lines,
            excluded_indices=self.selected_service_line_indices,
            popup_subtitle="Select another code. Previously selected codes are hidden.",
        )

        if selection is None:
            self.append_log("Another Code selection cancelled.")
            self.set_status("Another Code selection cancelled.", "info")
            return

        self.apply_procedure_selection(selection, from_another_code=True)
        self.handle_scraped_data(self.current_claim_data)
        self.update_another_code_button_state()

    def get_remaining_service_line_indices(self):
        return [
            index
            for index in range(len(self.current_service_lines))
            if index not in self.selected_service_line_indices
        ]

    def update_another_code_button_state(self):
        def update():
            try:
                remaining = self.get_remaining_service_line_indices()
                can_use = bool(self.current_service_lines) and bool(remaining)
                state = tk.NORMAL if can_use else tk.DISABLED
                self.another_code_btn.config(state=state)
            except Exception:
                pass

        self.root.after(0, update)

