    def get_claim_status_for_popup(self):
        """Return the current claim status for the CPT/procedure popup."""
        status = ""
        try:
            status = str(self.current_claim_data.get("Claim Status", "") or "").strip()
        except Exception:
            status = ""

        if self.is_not_found_or_blank(status):
            return "--"

        return status

    def ask_procedure_selection_threadsafe(self, service_lines, excluded_indices=None, popup_subtitle=""):
        """Show the CPT/procedure selector popup.

        Safe for both Selenium worker-thread calls and main UI-thread calls
        such as the Another Code button. The previous queue.get() behavior
        could freeze the UI when called directly from a Tkinter button.
        """
        result_queue = queue.Queue(maxsize=1)
        excluded_indices = excluded_indices or set()
        result_holder = {"value": None, "set": False}

        def show_popup():
            popup = tk.Toplevel(self.root)
            popup.title("Select Procedure")
            popup.configure(bg=self.colors["panel"])
            popup.attributes("-topmost", True)
            popup.resizable(False, False)
            popup.grab_set()

            title_label = tk.Label(
                popup,
                text="Which procedure is the caller inquiring?",
                bg=self.colors["panel"],
                fg="white",
                font=("Segoe UI", 12, "bold"),
            )
            title_label.pack(padx=18, pady=(18, 4))

            visible_items = [
                (idx, row)
                for idx, row in enumerate(service_lines)
                if idx not in excluded_indices
            ]

            count_label = tk.Label(
                popup,
                text=f"Available CPT Code(s): {len(visible_items)} of {len(service_lines)}",
                bg=self.colors["panel"],
                fg="#DFF6FF",
                font=("Segoe UI", 10),
            )
            count_label.pack(padx=18, pady=(0, 3))

            if popup_subtitle:
                tk.Label(
                    popup,
                    text=popup_subtitle,
                    bg=self.colors["panel"],
                    fg="#DFF6FF",
                    font=("Segoe UI", 9),
                ).pack(padx=18, pady=(0, 10))
            else:
                tk.Frame(popup, bg=self.colors["panel"], height=8).pack()

            button_area = tk.Frame(popup, bg=self.colors["panel"])
            button_area.pack(padx=18, pady=(0, 12))

            def choose(value):
                result_holder["value"] = value
                result_holder["set"] = True

                if result_queue.empty():
                    result_queue.put(value)

                try:
                    popup.grab_release()
                except Exception:
                    pass

                popup.destroy()

            for visual_idx, (original_idx, row) in enumerate(visible_items):
                proc = self.get_display_proc_code(row) or f"Line {original_idx + 1}"

                row_index = visual_idx // MAX_CPT_BUTTONS_PER_ROW
                col_index = visual_idx % MAX_CPT_BUTTONS_PER_ROW

                btn = tk.Button(
                    button_area,
                    text=proc,
                    width=14,
                    bg="#0C4A6E",
                    fg="white",
                    activebackground="#075985",
                    relief=tk.FLAT,
