    def sync_caller_field_cache_from_ui(self):
        """Store current Callers Information values so switching templates does not lose typed data."""
        try:
            text = self.get_caller_info_text_from_ui()
        except Exception:
            text = ""

        for line in text.splitlines():
            if ":" not in line:
                continue
            label, value = line.split(":", 1)
            label = label.strip()
            value = value.strip()
            if not label:
                continue
            key = self.normalize_caller_label(label)
            # Preserve existing cached values when the currently visible template
            # does not contain a value for that field. Hard Reset clears the cache.
            if value:
                self.caller_field_cache[key] = value
            elif key not in self.caller_field_cache:
                self.caller_field_cache[key] = ""

    def normalize_caller_label(self, label):
        normalized = str(label or "").strip().lower()
        normalized = normalized.replace("'", "")
        normalized = re.sub(r"\s+", " ", normalized)
        if normalized in {"members id", "member id", "id"}:
            return "member id"
        return normalized

    def caller_template_labels_for_concern(self, concern=None):
        template = CALLERS_INFO_ELIGIBILITY_TEMPLATE if concern == "Eligibility" else CALLERS_INFO_CLAIMS_TEMPLATE
        return [line.split(":", 1)[0].strip() for line in template.splitlines() if ":" in line]

    def apply_caller_template_for_concern(self, concern=None):
        """Switch Callers Information template while preserving matching values where possible."""
        try:
            self.sync_caller_field_cache_from_ui()

            labels = self.caller_template_labels_for_concern(concern)
            lines = []
            for label in labels:
                key = self.normalize_caller_label(label)
                value = self.caller_field_cache.get(key, "")
                lines.append(f"{label}: {value}" if value else f"{label}:")

            self.callers_info_box.delete("1.0", tk.END)
            self.callers_info_box.insert(tk.END, "\n".join(lines))
        except Exception as e:
            self.append_log(f"Caller template switch warning: {type(e).__name__}: {e}")

