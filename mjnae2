    def finalize_to_notepad(self):
        """Copy the final documentation, replace all text in an open Notepad window, then paste."""
        # If the agent forgot to press F8 again, move captured notes to Additional notes first.
        self.commit_capture_notes_to_final_output(hide_after=True)
        text = self.build_combined_final_copy_text()

        if not text:
            system_modal_info("No Data", "No final output is available yet.")
            return

        pyperclip.copy(text)
        self.last_final_output_text = text
        self.last_clipboard_text = text

        hwnd = self.find_notepad_window()
        if not hwnd:
            system_modal_info(
                "Notepad Not Found",
                "Open Notepad first, then press F2 again. VisionDocs will replace the Notepad content automatically.",
            )
            self.set_status("Notepad not found. Documentation copied to clipboard.", "warning")
            self.append_log("F2 pressed, but no Notepad window was found. Text copied to clipboard only.")
            return

        try:
            self.bring_window_to_front(hwnd)
            time.sleep(0.25)

            kb = keyboard.Controller()

            # Replace existing Notepad content instead of appending.
            # Ctrl+A selects all text in Notepad, Delete clears it, Ctrl+V pastes the latest documentation.
            with kb.pressed(keyboard.Key.ctrl):
                kb.press("a")
                kb.release("a")

            time.sleep(0.05)
            kb.press(keyboard.Key.delete)
            kb.release(keyboard.Key.delete)

            time.sleep(0.05)
            with kb.pressed(keyboard.Key.ctrl):
                kb.press("v")
                kb.release("v")

            try:
                pyperclip.copy("")
                self.last_clipboard_text = ""
            except Exception:
                pass

            self.clear_capture_notes_state(hide=True)
            self.append_log("F2 pressed. Documentation replaced the current Notepad content. Clipboard and captured notes cleared.")
            self.set_status("Finalized. Notepad content replaced. Clipboard cleared.", "success")
        except Exception as e:
            self.append_log(f"Notepad paste warning: {type(e).__name__}: {e}")
            system_modal_info(
                "Paste Warning",
                "The documentation was copied to clipboard, but VisionDocs could not replace the Notepad content automatically.",
            )
            self.set_status("Documentation copied to clipboard. Auto-replace failed.", "warning")

    def find_notepad_window(self):
        """Return the first visible Notepad window handle, if available."""
        try:
            user32 = ctypes.windll.user32
            matches = []

            EnumWindowsProc = ctypes.WINFUNCTYPE(ctypes.c_bool, ctypes.c_void_p, ctypes.c_void_p)

            def callback(hwnd, _lparam):
                try:
                    if not user32.IsWindowVisible(hwnd):
                        return True

                    length = user32.GetWindowTextLengthW(hwnd)
                    if length <= 0:
                        return True

                    title_buffer = ctypes.create_unicode_buffer(length + 1)
                    user32.GetWindowTextW(hwnd, title_buffer, length + 1)
                    title = title_buffer.value.strip()

                    class_buffer = ctypes.create_unicode_buffer(256)
                    user32.GetClassNameW(hwnd, class_buffer, 256)
                    class_name = class_buffer.value.strip()

                    haystack = f"{title} {class_name}".lower()
                    if "notepad" in haystack:
                        matches.append(hwnd)
                except Exception:
                    pass
                return True

            user32.EnumWindows(EnumWindowsProc(callback), 0)
            return matches[0] if matches else None
        except Exception as e:
            self.append_log(f"Find Notepad warning: {type(e).__name__}: {e}")
            return None

    def bring_window_to_front(self, hwnd):
        user32 = ctypes.windll.user32
        SW_RESTORE = 9
        try:
            user32.ShowWindow(hwnd, SW_RESTORE)
        except Exception:
            pass
        user32.SetForegroundWindow(hwnd)

