    def normalize_dental_code(self, value):
        text = str(value or "").upper().strip()

        match_with_d = re.search(r"\bD\s*(\d{4})\b", text)
        if match_with_d:
            return f"D{match_with_d.group(1)}"

        match_number = re.search(r"\b(\d{4})\b", text)
        if match_number:
            return f"D{match_number.group(1)}"

        return ""

    def code_to_number(self, code):
        normalized = self.normalize_dental_code(code)
        if not normalized:
            return None
        return int(normalized[1:])

    def rule_matches_code(self, rule, code):
        normalized = self.normalize_dental_code(code)
        if not normalized:
            return False

        if normalized in rule.get("codes", []):
            return True

        code_num = self.code_to_number(normalized)
        if code_num is None:
            return False

        for start_code, end_code in rule.get("ranges", []):
            start_num = self.code_to_number(start_code)
            end_num = self.code_to_number(end_code)

            if start_num is None or end_num is None:
                continue

            if start_num <= code_num <= end_num:
                return True

        return False

    def get_dental_advisory_requirements(self, code):
        normalized = self.normalize_dental_code(code)
        if not normalized:
            return []

        override_matches = [
            rule
            for rule in DENTAL_ADVISORY_RULES
            if rule.get("override") and self.rule_matches_code(rule, normalized)
        ]

        if override_matches:
            return self.unique_preserve_order(
                requirement
                for rule in override_matches
                for requirement in rule.get("requirements", [])
            )

        matched_rules = [
            rule
            for rule in DENTAL_ADVISORY_RULES
            if not rule.get("override") and self.rule_matches_code(rule, normalized)
        ]

        requirements = self.unique_preserve_order(
            requirement
            for rule in matched_rules
            for requirement in rule.get("requirements", [])
        )

        if normalized in ADDITIONAL_INFO_TRIGGER_CODES:
            requirements = self.unique_preserve_order(
                list(requirements)
                + [
                    "Is there root canal history needed? (Request in writing)",
                    "X-rays needed? (Request in writing)",
                ]
            )

        return requirements

    def unique_preserve_order(self, values):
        seen = set()
        output = []

        for value in values:
            key = str(value).strip().lower()
            if not key or key in seen:
                continue
            seen.add(key)
            output.append(str(value).strip())

        return output

    def show_advisory_for_selected_codes(self):
        codes = self.get_selected_procedure_codes()
        self.show_advisory_for_codes(codes)

    def show_advisory_for_codes(self, codes):
        normalized_codes = self.unique_preserve_order(
            self.normalize_dental_code(code)
            for code in codes
            if self.normalize_dental_code(code)
        )

        if not normalized_codes:
            return

        advisory_blocks = []

        for code in normalized_codes:
            requirements = self.get_dental_advisory_requirements(code)
            if not requirements:
                continue

            message = self.format_advisory_message(code, requirements)
            advisory_blocks.append(message)
            self.add_advisory_note(code, requirements)

        if not advisory_blocks:
            return

        system_modal_info(
            "Knowledge Article 56494 - Next Best Action",
            "\n\n".join(advisory_blocks),
        )

    def format_advisory_message(self, code, requirements):
        lines = [f"For code {code}, ask for the following information:", ""]
        for item in requirements:
            lines.append(f"- {item}")
        return "\n".join(lines)

    def add_advisory_note(self, code, requirements):
        normalized = self.normalize_dental_code(code)
        if not normalized:
            return

        existing_codes = {
            note.get("code")
            for note in self.current_advisory_notes
        }

        if normalized in existing_codes:
            return

        self.current_advisory_notes.append(
            {
                "code": normalized,
                "requirements": list(requirements),
            }
        )

    def build_advisory_section_for_output(self):
        if not self.current_advisory_notes:
            return ""

        lines = ["Information to ask / document if applicable:"]

        for note in self.current_advisory_notes:
            code = note.get("code", "")
            requirements = note.get("requirements", [])

            lines.append("")
            lines.append(f"{code}:")

            for requirement in requirements:
                lines.append(f"- {requirement}:")

        return "\n".join(lines).strip()

    def build_advisory_section_for_raw(self):
        if not self.current_advisory_notes:
            return "No dental advisory reminder for selected code(s)."

        blocks = []

        for note in self.current_advisory_notes:
            blocks.append(self.format_advisory_message(note.get("code", ""), note.get("requirements", [])))

        return "\n\n".join(blocks)

    # =========================
    # OUTPUT FORMAT
    # =========================

    def format_extracted_data(self, claim_data):
        lines = []

        lines.append("Claim / Provider Information")
        lines.append("----------------------------")

        for key, value in claim_data.items():
            lines.append(f"{key}: {value}")

        lines.append("")
        lines.append(f"Provider Concern: {self.provider_concern or 'Not selected'}")
        lines.append(f"DOS: {self.get_claim_summary_dos()}")
        lines.append(f"DCN: {claim_data.get('DCN', '') if claim_data.get('DCN') != 'Not found' else ''}")
        lines.append(f"Claim Status: {claim_data.get('Claim Status', '') if claim_data.get('Claim Status') != 'Not found' else ''}")
        lines.append(f"CLMT/CLM/PYMT: {claim_data.get('Claim Number', 'Not found')}")
        lines.append(f"Number of CPT Code: {len(self.current_service_lines)}")
        lines.append(f"Selected Procedure: {self.get_selected_procedure_text()}")

        lines.append("")
        lines.append("Dental Advisory Reminder")
        lines.append("------------------------")
        lines.append(self.build_advisory_section_for_raw())

        lines.append("")
        lines.append("Service Lines")
        lines.append("-------------")

        if not self.current_service_lines:
            lines.append("No service line data found.")
        else:
            for index, row in enumerate(self.current_service_lines, start=1):
                parts = []

                for col_name, _ in SERVICE_LINE_COLUMNS:
                    value = row.get(col_name, "")
                    parts.append(f"{col_name}: {value}")

                lines.append(f"Service Line {index}: " + " | ".join(parts))

        lines.append("")
        lines.append("Total")
        lines.append("-----")

        if self.current_total_line:
            total_parts = []

            for col_name, _ in SERVICE_LINE_COLUMNS:
                value = self.current_total_line.get(col_name, "")
                if value:
                    total_parts.append(f"{col_name}: {value}")

            lines.append(" | ".join(total_parts))
        else:
            lines.append("Total row not found.")

        return "\n".join(lines)

    def value_or_generic(self, value, generic):
        if not value:
            return generic

        if str(value).strip().lower() == "not found":
            return generic

        return str(value).strip()

    def get_claim_summary_dos(self):
        earliest = self.get_earliest_dos_from_service_lines()
        return earliest if earliest else "Not found"

    def get_earliest_dos_from_service_lines(self):
        dated_values = []

        for row in self.current_service_lines:
            raw_dos = str(row.get("DoS", "") or "").strip()
            parsed_date = self.parse_dos_date(raw_dos)

            if parsed_date:
                dated_values.append((parsed_date, raw_dos))

        if not dated_values:
            return ""

        dated_values.sort(key=lambda item: item[0])
        return dated_values[0][1]

    def parse_dos_date(self, value):
        text = str(value or "").strip()

        if not text:
            return None

        for pattern in ["%m/%d/%Y", "%m/%d/%y", "%Y-%m-%d"]:
            try:
                return datetime.strptime(text, pattern)
            except ValueError:
                continue

        return None

    def build_final_output(self, claim_data):
        claim_number = self.value_or_generic(claim_data.get("Claim Number"), "the selected claim")
        selected_procedure = self.get_selected_procedure_text()
        service_line_details = self.build_service_line_details_for_note()
        additional_notes = "Additional notes:"

        dos = self.get_claim_summary_dos()
        dcn = claim_data.get("DCN", "") if claim_data.get("DCN") != "Not found" else ""
        claim_status = claim_data.get("Claim Status", "") if claim_data.get("Claim Status") != "Not found" else ""

        return (
            f"DOS: {dos}\n"
            f"DCN: {dcn}\n"
            f"Claim Status: {claim_status}\n"
            f"CLMT/CLM/PYMT: {claim_number}\n\n"
            f"Provider concern: {self.provider_concern or 'Not selected'}\n\n"
            f"Reviewed claim {claim_number} in OneView for provider and service line information.\n\n"
            f"The caller inquired about {selected_procedure}. "
            f"There are {len(self.current_service_lines)} CPT code(s) available on the claim.\n\n"
            f"Service line information:\n"
            f"{service_line_details}\n\n"
            f"{additional_notes}"
        )

    def get_selected_procedure_text(self):
        if self.selected_procedure_mode == "ALL":
            return "all available procedures"

        selected_codes = self.get_selected_procedure_codes()

        if selected_codes:
            return self.join_human_readable(selected_codes)

        return "the available claim information"

    def get_selected_procedure_codes(self):
        if self.selected_procedure_mode == "ALL":
            return self.unique_preserve_order(
                self.get_display_proc_code(row)
                for row in self.current_service_lines
                if self.get_display_proc_code(row)
            )

        if self.selected_service_lines:
            return self.unique_preserve_order(
                self.get_display_proc_code(row)
                for row in self.selected_service_lines
                if self.get_display_proc_code(row)
            )

        if self.selected_service_line:
            code = self.get_display_proc_code(self.selected_service_line)
            return [code] if code else []

        return []

    def get_display_proc_code(self, row):
        raw_proc = row.get("Proc/Mod", "") if isinstance(row, dict) else str(row or "")
        normalized = self.normalize_dental_code(raw_proc)
        return normalized if normalized else raw_proc.strip()

    def join_human_readable(self, values):
        items = [str(value).strip() for value in values if str(value).strip()]

        if not items:
            return ""

        if len(items) == 1:
            return items[0]

        if len(items) == 2:
            return f"{items[0]} and {items[1]}"

        return ", ".join(items[:-1]) + f", and {items[-1]}"

    def build_service_line_details_for_note(self):
        if self.selected_procedure_mode == "ALL" and self.current_service_lines:
            blocks = []

            for index, row in enumerate(self.current_service_lines, start=1):
                blocks.append(self.format_service_line_block(row, index))

            return "\n\n".join(blocks)

        if self.selected_service_lines:
            blocks = []

            for display_index, row in enumerate(self.selected_service_lines, start=1):
                original_index = self.current_service_lines.index(row) + 1 if row in self.current_service_lines else display_index
                blocks.append(self.format_service_line_block(row, original_index))

            return "\n\n".join(blocks)

        return "No service line details were captured."

    def get_display_proc_with_description(self, row):
        raw_proc = str(row.get("Proc/Mod", "") if isinstance(row, dict) else row or "").strip()
        code = self.normalize_dental_code(raw_proc)

        if not raw_proc:
            return code or "Not found"

        description = re.sub(r"^\s*D?\d{4}\s*-\s*", "", raw_proc, flags=re.IGNORECASE).strip()

        if code and description:
            return f"{code} - {description}"

        return code or raw_proc

    def format_service_line_block(self, row, index):
        lines = [f"Service Line {index}"]

        field_order = [
            ("Proc/Mod", self.get_display_proc_with_description(row)),
            ("DoS", row.get("DoS", "")),
            ("Charge", row.get("Charge", "")),
            ("Ded", row.get("Ded", "")),
            ("Balance", row.get("Balance", "")),
            ("Patient Resp", row.get("Patient Resp", "")),
        ]

        for label, value in field_order:
            value = str(value or "").strip()
            if value:
                lines.append(f"{label}: {value}")

        return "\n".join(lines)

    def build_total_details_for_note(self):
        if not self.current_total_line:
            return "Total row was not available."

        lines = []

        for col_name, _ in SERVICE_LINE_COLUMNS:
            value = self.current_total_line.get(col_name, "").strip()

            if value:
                lines.append(f"{col_name}: {value}")

        if not lines:
            return "Total row was available but no total values were captured."

        return "\n".join(lines)

    def handle_scraped_data(self, claim_data):
        self.autofill_callers_information_from_claim(claim_data)
        extracted_text = self.format_extracted_data(claim_data)
        final_output_text = self.build_final_output(claim_data)
        self.update_claim_status_display(claim_data)

        self.last_extracted_text = extracted_text
        self.last_final_output_text = final_output_text

        combined_copy_text = self.build_combined_final_copy_text(final_text=final_output_text)
        self.last_clipboard_text = combined_copy_text
        pyperclip.copy(combined_copy_text)

        self.set_text_box(self.extracted_data_box, extracted_text)
        self.set_text_box(self.final_output_box, final_output_text)

        self.append_log("===== CLAIM DATA CAPTURED =====")

        for key, value in claim_data.items():
            self.append_log(f"{key}: {value}")

        self.append_log(f"CPT rows captured: {len(self.current_service_lines)}")

        if self.current_total_line:
            self.append_log("Total row captured.")
        else:
            self.append_log("Total row not captured.")

        self.append_log("===============================")
        self.append_log("Callers Information + Final Output prepared.")
        self.append_log("Open Notepad and press F2 to finalize.")

        self.set_status("Claim documentation generated and copied to clipboard.", "success")

    # =========================
    # CLOSE
    # =========================

    def on_close(self):
        self.stop_event.set()

        try:
            if self.hotkey_listener:
                self.hotkey_listener.stop()
        except Exception:
            pass

        self.root.destroy()


def main():
    root = tk.Tk()
    OneViewWatcherApp(root)
    root.mainloop()


if __name__ == "__main__":
    main()
