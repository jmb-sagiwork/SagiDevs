    def scrape_claim_data(self):
        data = {}

        self.ensure_claim_info_accordion_open()

        for field in SCRAPE_FIELDS:
            field_name = field["name"]
            xpath = field["xpath"]
            mode = field["mode"]

            value = self.get_text_if_exists(
                xpath=xpath,
                mode=mode,
                field_name=field_name,
            )

            if field_name == "DCN":
                raw_dcn_text = value or ""
                data["DCN Raw"] = raw_dcn_text if raw_dcn_text else "Not found"
                data["DCN"] = self.extract_dcn(raw_dcn_text) if raw_dcn_text else "Not found"
                data["Claim Status"] = self.extract_claim_status(raw_dcn_text) if raw_dcn_text else "Not found"
                continue

            data[field_name] = value if value else "Not found"

        if "Claim Status" not in data:
            data["Claim Status"] = "Not found"

        return data

    def extract_dcn(self, value):
        text = str(value or "").replace("\xa0", " ").strip()

        match = re.search(r"\b[A-Z]\d{8,}\b", text, flags=re.IGNORECASE)
        if match:
            return match.group(0).upper()

        first_part = re.split(r"\s+-\s+|\s+Claim:\s+", text, maxsplit=1, flags=re.IGNORECASE)[0].strip()
        return first_part

    def extract_claim_status(self, value):
        text = re.sub(r"\s+", " ", str(value or "").replace("\xa0", " ")).strip()
        if not text:
            return ""

        match = re.search(
            r"^[A-Z]\d{8,}\s*-\s*(.+?)(?=\s+Claim:|\s+Payment:|\s+Indicator:|$)",
            text,
            flags=re.IGNORECASE,
        )
        if match:
            return match.group(1).strip()

        parts = re.split(r"\s+Claim:\s+", text, maxsplit=1, flags=re.IGNORECASE)
        if parts:
            status_part = re.split(r"\s*-\s*", parts[0], maxsplit=1)
            if len(status_part) > 1:
                return status_part[1].strip()

        return ""

    def parse_patient_name_from_member_text(self, value):
