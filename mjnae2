            )
            status_label.pack(padx=18, pady=(0, 14))

            rows_needed = max(1, math.ceil(max(1, len(visible_items)) / MAX_CPT_BUTTONS_PER_ROW))
            cols_needed = min(MAX_CPT_BUTTONS_PER_ROW, max(1, len(visible_items)))

            estimated_width = max(480, cols_needed * 130)
            estimated_height = 220 + (rows_needed * 45)

            popup.geometry(f"{estimated_width}x{estimated_height}")
            popup.update_idletasks()
            self.center_popup(popup)
            popup.lift()
            popup.focus_force()

            try:
                popup.attributes("-topmost", True)
                popup.after(500, lambda: popup.attributes("-topmost", True))
            except Exception:
                pass

            popup.protocol("WM_DELETE_WINDOW", lambda: choose(None))
            return popup

        # If this is called from the UI button Another Code, avoid queue.get()
        # because that blocks Tkinter and prevents the popup from rendering.
        if threading.get_ident() == self.ui_thread_id:
            popup = show_popup()
            self.root.wait_window(popup)
            return result_holder["value"] if result_holder["set"] else None

        self.root.after(0, show_popup)
        return result_queue.get()

